# Cariño backend environment — copy the VALUES into your build command or CI
# secrets. This file itself contains no real keys and is never compiled in.
#
# Run against the live Supabase backend:
#   flutter run \
#     --dart-define=SUPABASE_URL=https://YOUR-PROJECT.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=YOUR-ANON-KEY \
#     --dart-define=USE_MOCK_BACKEND=false
#
# Run fully local (default when no defines are passed):
#   flutter run            # mock services, demo data, nothing leaves the device
#
# SUPABASE_URL       — Project URL from Supabase dashboard → Settings → API
# SUPABASE_ANON_KEY  — The PUBLIC anon key (safe in the client; RLS guards
#                      every table). NEVER put the service-role key in the app.
# USE_MOCK_BACKEND   — true forces stub services even when a backend exists
#                      (used by store-review demo builds and offline dev).
SUPABASE_URL=
SUPABASE_ANON_KEY=
USE_MOCK_BACKEND=true
